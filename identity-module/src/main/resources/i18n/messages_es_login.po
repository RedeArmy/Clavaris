# Spanish text of the consuming application's sign-in page (identity/login.html): English source
# text -> Spanish. "Sign in" itself lives in messages_es.po. See
# docs/05-engineering/internationalization.md.

# The application's own name rides in the <0>{0}</0> tag, so it is never translated.
msgid "Sign in to <0>{0}</0>"
msgstr "Inicia sesión en <0>{0}</0>"

# The browser tab: the application's name, then the fixed words.
msgid "{0} — Sign in"
msgstr "{0} — Iniciar sesión"

# The logo's alternative text when the application has a logo but no display name.
msgid "Application logo"
msgstr "Logotipo de la aplicación"

# The sign-in that leads with the one-time access code (ADR-0037): only the identifier is asked first.
msgid "Use a password instead"
msgstr "Usar una contraseña"

# The code pages (login-email-code-request.html, login-email-code-confirm.html), which now also take a username.
msgid "Enter your username or email address and we'll send you a one-time code."
msgstr "Introduce tu usuario o tu correo electrónico y te enviaremos un código de un solo uso."

msgid "Use a different email or username, or send a new code"
msgstr "Usar otro correo o usuario, o enviar un código nuevo"

msgid "Email or username is required"
msgstr "El correo o el usuario es obligatorio"

# Asking for another verification email (ADR-0038): the pages, and the links to them.
msgid "Send the email again"
msgstr "Enviar el correo de nuevo"

msgid "Enter your username or the email address you registered with and we'll send you a new verification message."
msgstr "Introduce tu usuario o el correo con el que te registraste y te enviaremos un nuevo mensaje de verificación."

msgid "Enter the email address you registered with and we'll send you a new verification message."
msgstr "Introduce el correo con el que te registraste y te enviaremos un nuevo mensaje de verificación."

msgid "Send"
msgstr "Enviar"

msgid "If that address belongs to an account that still needs verifying, we've sent it a new message. It can take a minute to arrive; if you asked a moment ago, the one you already have still works."
msgstr "Si esa dirección pertenece a una cuenta que aún debe verificarse, le hemos enviado un mensaje nuevo. Puede tardar un minuto en llegar; si lo pediste hace un momento, el que ya tienes sigue siendo válido."

msgid "Got a code? <0>Enter it here</0>."
msgstr "¿Tienes un código? <0>Introdúcelo aquí</0>."

msgid "Send it again"
msgstr "Enviarlo de nuevo"

msgid "Send the verification email again"
msgstr "Enviar de nuevo el correo de verificación"

msgid "Send a new code"
msgstr "Enviar un código nuevo"
