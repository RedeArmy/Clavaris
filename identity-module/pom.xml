<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.clavaris</groupId>
        <artifactId>clavaris-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>identity-module</artifactId>
    <packaging>jar</packaging>
    <name>identity-module</name>
    <description>
        Accounts, password credentials, linked social identities, sessions, email verification,
        password recovery, refresh token issuance/rotation, signing key (JWKS) management.
        First real use case: RegisterAccount.
    </description>

    <properties>
        <!-- git-workflow.md §4a: SonarCloud's Java analyzer only scans src/main/java by default —
             the hosted login/consent Thymeleaf templates under src/main/resources/templates
             (register.html, register-pending-verification.html) were going unindexed, which
             disables its Java-based XSS detection against them entirely. Only added here, not at
             the reactor root, because identity-module is currently the only module with Thymeleaf
             templates to index — the other modules' src/main/resources is just Flyway migrations
             and application config, nothing this property changes anything about. -->
        <sonar.sources>src/main/java,src/main/resources</sonar.sources>
        <!-- 2026-09-09: moved here (and into each of the other 5 real modules' own pom.xml) from a
             blanket -D on ci.yml's own sonarcloud step — that CLI flag applied the identical value
             to clavaris-parent too, which has no source of its own and can never resolve
             "../app/..." from its own basedir, producing a permanent "no coverage report can be
             found" warning there. This property is resolved per module, relative to THAT module's
             own basedir (confirmed against SonarSource's own docs) — declaring it here, not at the
             reactor root, is what the docs actually recommend for this exact scenario. See
             clavaris-parent's own pom.xml comment on this property for the full history.
             app/pom.xml's report-aggregate execution combines every reactor module's exec data
             against every dependency's own compiled classes into one file at
             app/target/site/jacoco-aggregate/jacoco.xml — this module's own persistence adapters
             are genuinely exercised by RegisterAccountIntegrationTest, which lives in app/ (needs
             the full Spring context), so this module's own default per-module report alone would
             miss that real coverage. -->
        <sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml,../app/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencies>
        <!-- TD-SEC-007: AuditEventRecorder — RotateSigningKeyForOrganizationService writes a
             signing_key.rotated audit row in the same transaction as the rotation itself. Same
             threshold/rationale as organization-module's own identical dependency. -->
        <dependency>
            <groupId>com.clavaris</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Inbound web adapter (infrastructure/adapter/in/web) — @Controller, form binding. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- TD-SEC-008: RotateSigningKeyController reads the request's own Authentication to
             resolve who is calling (AuditActor) — same rationale as organization-module's own
             identical dependency, spring-security-core alone for the type, no filter chain here. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <!-- @Operation/@ApiResponse on RotateSigningKeyController (ADR-0008) — same convention as
             organization-module/client-registry-module's own identical dependency; this module's
             first genuine JSON @RestController, the rest of its web adapters are Thymeleaf forms. -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.55</version>
        </dependency>
        <!-- Hosted login/consent UI is server-side rendered Thymeleaf, not a SPA. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!-- Bean Validation (@NotBlank, @Email, ...) on the web-layer form DTO — not bundled with
             spring-boot-starter-web since Spring Boot 2.3+, needs its own starter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Outbound persistence adapters (infrastructure/adapter/out/persistence) — @Entity,
             Spring Data repositories, @Transactional (data-model.md §2: accounts,
             password_credentials, event_outbox all owned by this module's own migrations). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- ADR-0005: Argon2PasswordEncoder. spring-security-crypto only — this module doesn't
             need the full spring-security-config/oauth2-resource-server stack (that belongs to
             client-registry-module's protocol surface, not to hashing a password). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Argon2PasswordEncoder's actual Argon2 implementation is BouncyCastle, declared
             optional by spring-security-crypto (not pulled in transitively, not managed by the
             Spring Boot BOM either) — confirmed live: hashing failed with
             NoClassDefFoundError: org/bouncycastle/crypto/params/Argon2Parameters$Builder
             without this. Runtime-only: nothing in this codebase references BouncyCastle types
             directly, only Argon2PasswordEncoder's own internals do. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.85.2</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- test-strategy.md §2: persistence adapters get a real-Postgres integration test, not
             just a mocked-port unit test — JpaSigningKeyRepositoryTest/
             JpaPlatformSigningKeyRepositoryTest run the actual migrations (not a
             Hibernate-generated schema), scoped to this module alone. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
