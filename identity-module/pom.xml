<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.clavaris</groupId>
        <artifactId>clavaris-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>identity-module</artifactId>
    <packaging>jar</packaging>
    <name>identity-module</name>
    <description>
        Accounts, password credentials, linked social identities, sessions, email verification,
        password recovery, refresh token issuance/rotation, signing key (JWKS) management
        (CLAUDE.md §4). First real use case: RegisterAccount.
    </description>

    <dependencies>
        <!-- Inbound web adapter (infrastructure/adapter/in/web) — @Controller, form binding. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- CLAUDE.md §3: hosted login/consent UI is server-side rendered Thymeleaf, not a SPA. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!-- Bean Validation (@NotBlank, @Email, ...) on the web-layer form DTO — not bundled with
             spring-boot-starter-web since Spring Boot 2.3+, needs its own starter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Outbound persistence adapters (infrastructure/adapter/out/persistence) — @Entity,
             Spring Data repositories, @Transactional (data-model.md §2: accounts,
             password_credentials, event_outbox all owned by this module's own migrations). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- ADR-0005: Argon2PasswordEncoder. spring-security-crypto only — this module doesn't
             need the full spring-security-config/oauth2-resource-server stack (that belongs to
             client-registry-module's protocol surface, not to hashing a password). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Argon2PasswordEncoder's actual Argon2 implementation is BouncyCastle, declared
             optional by spring-security-crypto (not pulled in transitively, not managed by the
             Spring Boot BOM either) — confirmed live: hashing failed with
             NoClassDefFoundError: org/bouncycastle/crypto/params/Argon2Parameters$Builder
             without this. Runtime-only: nothing in this codebase references BouncyCastle types
             directly, only Argon2PasswordEncoder's own internals do. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.85.2</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- test-strategy.md §2: persistence adapters get a real-Postgres integration test, not
             just a mocked-port unit test — JpaSigningKeyRepositoryTest/
             JpaPlatformSigningKeyRepositoryTest run the actual migrations (not a
             Hibernate-generated schema), scoped to this module alone. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
