# Copy to .env and fill in real values locally. Never commit .env.
# This file lists variable names only — no values, no credentials.

# ---- Deployment origin ----
# The canonical scheme://host:port this instance is reachable at — used as the platform issuer's
# own `iss` claim (ADR-0010, Organization provisioning; never /o/{organizationId}-prefixed) and,
# once per-Organization issuers exist, as the base every {clavarisBaseUrl}/o/{organizationId} URL
# is built from. Defaults to http://localhost:8080 if unset.
CLAVARIS_BASE_URL=

# ---- Local Postgres (Docker, dev profile) ----
DB_DEV_HOST=
DB_DEV_PORT=
DB_DEV_NAME=
DB_DEV_USER=
DB_DEV_PASSWORD=

# ---- Redis (dev) — rate limiting + session cache ----
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
# TD-PERF-051: most concurrent browser sessions per Account (oldest-used ended on the next sign-in);
# 0 = unlimited. Optional, default 10.
# CLAVARIS_SESSION_MAX_PER_ACCOUNT=10

# ---- Token signing (ADR-0002 — RS256) ----
# TD-SEC-002/TD-SEC-054: TOKEN_SIGNING_KEY_STORE_PATH is a directory (its filename component is
# ignored beyond naming the parent directory) — SigningKeyStore keeps one PKCS12 file per scope
# there (the platform tier's own, and one per Organization), each protected by its own password
# *derived* from TOKEN_SIGNING_KEY_STORE_PASSWORD, never a directly-used shared password anymore —
# see SigningKeyStore's own Javadoc for why a single shared file/password meant a storage-layer
# compromise was never actually single-tenant. Never the database (data-model.md §2). Generate a
# real, unique path/password per environment; never reuse across dev/staging/prod, and never commit
# either value.
TOKEN_SIGNING_KEY_STORE_PATH=
TOKEN_SIGNING_KEY_STORE_PASSWORD=

# ---- oauth2_authorization token hashing (TD-SEC-019) ----
# Keys the HMAC-SHA256 digest computed for every access token, authorization code, and ID token
# value before it is written to oauth2_authorization (BearerTokenHasher) — without this, a
# Postgres compromise/backup leak would expose every currently-valid bearer credential directly
# usable, not just a hash of it. Generate a long random secret per environment; never reuse across
# dev/staging/prod, and never commit a real value.
OAUTH2_TOKEN_HASH_SECRET=

# ---- Rate-limit key hashing (TD-SEC-023) ----
# Keys the HMAC-SHA256 digest computed for every rate-limit identifier (email, IP, client_id)
# before it becomes part of a Redis key (RateLimitKeyHasher) — without this, anyone who can read
# the Redis keyspace (an operator, a read replica, an RDB/AOF backup) could recover the raw
# identifier via an offline dictionary attack against a plain digest. A dedicated secret,
# deliberately not the same value as OAUTH2_TOKEN_HASH_SECRET above — generate and rotate
# independently, never reuse across dev/staging/prod, and never commit a real value.
RATE_LIMIT_KEY_HASH_SECRET=

# ---- Idempotency-Key support for /api/v1/admin/** (IdempotencyKeyFilter) ----
# Same "hash a caller-controlled value before it becomes part of a Redis key" discipline as
# RATE_LIMIT_KEY_HASH_SECRET above — a dedicated secret, never reused across purposes. Generate and
# rotate independently, never commit a real value.
IDEMPOTENCY_KEY_HASH_SECRET=

# ---- Webhook signing-secret encryption at rest (ADR-0007) ----
# AES-256-GCM key (AesGcmWebhookSigningSecretCipher) every Organization's every WebhookEndpoint
# signing secret is encrypted under at rest — must be recoverable in cleartext at delivery time, so
# it can't be a one-way hash like the secrets above. Base64-encoded, must decode to exactly 32
# bytes (256 bits) — generate with `openssl rand -base64 32`, never a human-typed passphrase.
# Generate a real, unique value per environment; never reuse across dev/staging/prod, and never
# commit a real value (SDE-III review, 2026-09-04 — GitGuardian caught exactly this in
# application.yml's own dev-only default; this entry closes the gap that let it happen, the same
# convention every other secret in this section already followed).
WEBHOOK_SECRET_ENCRYPTION_KEY=
# Rotating an encryption key (this one and the two below, TD-SEC-086): a stored secret names the key
# that encrypted it (v1.<id>.…), so the key can be replaced without stopping the service. Set the
# new key as *_ENCRYPTION_KEY with a new *_ENCRYPTION_KEY_ID (1 to 16 letters, digits, - or _), and
# put the old one in *_PREVIOUS_KEYS as id:base64 (comma-separated for more than one). New secrets
# use the new key; old ones keep decrypting with the previous one until they are rewritten. Do not
# remove a previous key while any stored secret still names it. The default id is 1, which is also
# what a secret stored before key ids existed is read with.
# WEBHOOK_SECRET_ENCRYPTION_KEY_ID=1
# WEBHOOK_SECRET_PREVIOUS_KEYS=

# ---- Social OAuth credential encryption at rest (ADR-0022) ----
# AES-256-GCM key (AesGcmOrganizationSocialCredentialCipher) a PRODUCTION Organization's own
# Google/GitHub OAuth app client_secret is encrypted under at rest — must be recoverable in
# cleartext, since Clavaris presents it outbound to Google/GitHub on every token exchange. Own
# dedicated key, never reuse WEBHOOK_SECRET_ENCRYPTION_KEY above — generate and rotate
# independently, same convention every secret in this file follows. Base64-encoded, must decode to
# exactly 32 bytes (256 bits) — generate with `openssl rand -base64 32`; never commit a real value.
SOCIAL_CREDENTIAL_ENCRYPTION_KEY=
# SOCIAL_CREDENTIAL_ENCRYPTION_KEY_ID=1
# SOCIAL_CREDENTIAL_PREVIOUS_KEYS=

# ---- Authenticator-app secrets (ADR-0040) ----
# AesGcmTotpSecretCipher's key — each Account's authenticator-app secret is encrypted under it at
# rest (the server must read it back to check a code). Own dedicated key, generate and rotate
# independently of the two above. Base64-encoded, exactly 32 bytes — `openssl rand -base64 32`;
# never commit a real value. Rotation: see the note under WEBHOOK_SECRET_ENCRYPTION_KEY; replacing
# the key without keeping the old one as a previous key makes every enrolled authenticator
# unreadable, and those Accounts would have to be reset and re-enrol.
TOTP_SECRET_ENCRYPTION_KEY=
# TOTP_SECRET_ENCRYPTION_KEY_ID=1
# TOTP_SECRET_PREVIOUS_KEYS=
# TD-SEC-090: set to false, once the legacy-read counter has stayed at zero for a full release cycle
# and the queries in deployment-runbook.md §6 return zero, to refuse secrets stored before the envelope format.
# CRYPTO_ACCEPT_LEGACY_ENVELOPE=true

# ---- Profile picture storage (ADR-0026) ----
# SupabaseS3ProfilePictureStorage's own Supabase Storage (S3-compatible) credentials — generate a
# dedicated S3 access key pair from the Supabase project's own Storage settings, never reuse a
# key from anywhere else in this file. S3_ENDPOINT is that project's own
# https://<project-ref>.supabase.co/storage/v1/s3 URL; S3_REGION is required by the AWS SDK's own
# request-signing even though Supabase Storage isn't actually regional ("us-east-1" is Supabase's
# own documented recommendation, any valid AWS region string works). The bucket itself can stay
# private — nothing outside this codebase's own avatar-serving endpoint ever needs direct access to
# it (ADR-0026's whole "proxy through Clavaris, never hand out a Supabase URL" decision).
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=

# ---- Platform tier bootstrap (ADR-0010, Organization provisioning) ----
# Seeds the FIRST PlatformClient row at startup (idempotent check, never an
# HTTP endpoint — BR-PLATFORM-03). This is the one credential in the system
# that doesn't derive from anything else already inside it: whoever holds it
# can create/manage every Organization. Generate a long random secret per
# environment; never reuse across dev/staging/prod.
PLATFORM_BOOTSTRAP_CLIENT_ID=
PLATFORM_BOOTSTRAP_CLIENT_SECRET=

# ---- Social login providers (v1 scope: Google, GitHub) ----
# ADR-0020 Decision 4: one Clavaris-owned shared OAuth app per provider, not bring-your-own — every
# Organization's "Sign in with Google/GitHub" button goes through this same pair of credentials.
# Optional: left blank, application.yml's own dev-only placeholder lets the rest of the app start
# and work normally — only an actual /oauth2/authorization/{google,github} attempt fails (cleanly,
# against the provider itself) until real values are set here.
#
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> Create Credentials ->
#   OAuth client ID -> Application type: Web application. Authorized redirect URI must be exactly
#   {CLAVARIS_BASE_URL}/login/oauth2/code/google (Spring Security's own default callback path, no
#   override configured) — e.g. http://localhost:8080/login/oauth2/code/google for this local stack.
# GitHub: github.com/settings/developers -> OAuth Apps -> New OAuth App. Authorization callback
#   URL must be exactly {CLAVARIS_BASE_URL}/login/oauth2/code/github.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- Email delivery (verification, password reset) ----
# TD-SEC-004/ADR-0011: Resend's HTTP API, not SMTP — ResendMailSender (identity-module) posts
# directly to https://api.resend.com/emails. RESEND_API_KEY is issued by Resend; MAIL_FROM_ADDRESS
# must be an address on a domain verified with Resend (planned: a Zoho-managed domain) — an
# unverified from-address gets every send rejected by Resend itself.
RESEND_API_KEY=
MAIL_FROM_ADDRESS=

# ---- Observability (TD-FUT-011 / ADR-0015) — optional, docker-compose.observability.yml only ----
# Only needed if running `docker compose -f docker-compose.yml -f docker-compose.observability.yml
# up` (that file sets both of these itself). The span export is OFF unless CLAVARIS_ZIPKIN_ENABLED
# is true (TD-PROC-024): with it on and no Zipkin listening, every batch of spans logs a WARN
# ("Spans were dropped due to exceptions"). Tracing itself is always on; only the export is
# switched, so trace ids stay in the logs and the event outbox. To send spans to a collector of
# your own, set CLAVARIS_ZIPKIN_ENABLED=true and CLAVARIS_ZIPKIN_ENDPOINT to its
# .../api/v2/spans URL.
# CLAVARIS_ZIPKIN_ENABLED=false
CLAVARIS_ZIPKIN_ENDPOINT=
OBSERVABILITY_PROMETHEUS_PORT=
OBSERVABILITY_ALERTMANAGER_PORT=
OBSERVABILITY_MAILPIT_SMTP_PORT=
OBSERVABILITY_MAILPIT_UI_PORT=
OBSERVABILITY_GRAFANA_PORT=
OBSERVABILITY_GRAFANA_ADMIN_PASSWORD=
OBSERVABILITY_ZIPKIN_PORT=

# ---- event_outbox retention (TD-TEST-002) ----
# How many days EventOutboxRetentionJob (identity-module) keeps an event_outbox row before its
# daily sweep deletes it, regardless of whether webhook-module (not yet built, ADR-0007) ever
# consumed it. Defaults to 90 if unset — safe to leave blank in dev.
EVENT_OUTBOX_RETENTION_DAYS=

# ---- Capacity tuning (TD-PERF-007) — see deployment-runbook.md §2a for the full reasoning ----
# JAVA_OPTS: safe to leave blank — defaults to "-Xmx1536m -Xms512m" (docker-entrypoint.sh) either
# way, and IS wired through docker-compose.prod.yml's own app.environment block, so setting a real
# value here actually takes effect under that deployment path.
JAVA_OPTS=
# TASK_SCHEDULING_POOL_SIZE / TOMCAT_MAX_THREADS / DB_HIKARI_MAX_POOL_SIZE /
# DB_HIKARI_CONNECTION_TIMEOUT_MS / REDIS_COMMAND_TIMEOUT_MS: safe to leave blank for local dev
# (docker-compose.yml) and for `docker run`/Kubernetes/ECS deployments that pass the container's
# environment through directly. NOT yet wired into docker-compose.prod.yml's own app.environment
# block, deliberately — see deployment-runbook.md §2a for why (Spring's own config-property
# binding, unlike JAVA_OPTS above, breaks on a present-but-empty value the safe compose
# passthrough pattern would otherwise produce) — override one of these five under that specific
# deployment path by editing docker-compose.prod.yml directly instead.
TASK_SCHEDULING_POOL_SIZE=
TOMCAT_MAX_THREADS=
DB_HIKARI_MAX_POOL_SIZE=
DB_HIKARI_CONNECTION_TIMEOUT_MS=
# TD-PERF-010: Lettuce's own command timeout (application.yml's spring.data.redis.timeout) —
# defaults to 2000ms, well below Lettuce's own implicit 60s default this replaces.
# REDIS_MAXMEMORY / REDIS_MEM_LIMIT (production compose only, TD-SEC-083): the ceiling Redis refuses writes at
# (noeviction) and the container's limit above it. Blank takes the defaults, 512mb and 768m.
REDIS_MAXMEMORY=
REDIS_MEM_LIMIT=
# REDIS_COUNTERS_MAXMEMORY / REDIS_COUNTERS_MEM_LIMIT (production compose only, TD-SEC-095): the same two
# knobs for the second Redis that holds only abuse counters (volatile-ttl, evicts instead of refusing
# writes). Blank takes the defaults, 256mb and 384m. Locally the counters share the one Redis above.
REDIS_COUNTERS_MAXMEMORY=
REDIS_COUNTERS_MEM_LIMIT=
REDIS_COMMAND_TIMEOUT_MS=

# ---- Production database (managed Postgres, if not self-hosted) ----
PROD_DB_HOST=
PROD_DB_PORT=
PROD_DB_NAME=
PROD_DB_USER=
PROD_DB_PASSWORD=

# ---- Spring profile selector ----
# Required — docker-compose.yml refuses to start without this set (TD-SEC-013: no silent
# fallback). Use "dev" for local development against the Docker stack; application-dev.yml's own
# header comment states it must never be used in a real deployment. The application itself also
# refuses to start with application.yml's public development secrets under any profile but "dev" or
# "test" (DevDefaultSecretsStartupGuard), so "dev" is also what a local run outside Docker needs.
SPRING_PROFILES_ACTIVE=

# ---- Production deployment only (TD-FUT-013, docker-compose.prod.yml) ----
# Not read by docker-compose.yml (local dev) at all — separate variable names from DB_DEV_*
# on purpose, so a single shared .env can never accidentally point a production compose run at a
# developer's own local Postgres credentials, or vice versa.
DB_PROD_HOST=
DB_PROD_PORT=
DB_PROD_NAME=
DB_PROD_USER=
DB_PROD_PASSWORD=
# The bare hostname (no scheme) Caddy issues its Let's Encrypt certificate for — e.g.
# auth.example.com. Must already resolve to this host's public IP, see deployment-runbook.md.
CLAVARIS_DOMAIN=
# The lowercase GitHub org/user that owns this repo — ci.yml's own docker-build job pushes to
# ghcr.io/<this value>/clavaris. Case-sensitive to GHCR's own lowercase-only requirement.
GHCR_IMAGE_OWNER=
# Which tag docker-compose.prod.yml pulls — "latest" (default, if left blank) or a specific
# ci.yml-pushed :<git-sha> for a reproducible rollback target. See deployment-runbook.md's own
# "rolling back" section before pinning this to anything other than latest.
CLAVARIS_IMAGE_TAG=
# RFC 9116 /.well-known/security.txt. Off until BOTH are set; with either missing or past, the
# endpoint answers 404. SECURITY_TXT_CONTACT is a mailto:, https: or tel: URI; SECURITY_TXT_EXPIRES
# an ISO-8601 instant in the future (renew it before it passes — the file is ignored once expired).
SECURITY_TXT_CONTACT=
SECURITY_TXT_EXPIRES=
SECURITY_TXT_POLICY=

# TD-PROC-032: optional knobs of docker-compose.monitoring.yml, which deploy.sh starts only when
# monitoring/alertmanager.yml exists (deployment-runbook.md section 7e). The defaults are fine;
# left commented so a host that does not set them is not told it is missing something.
# MONITORING_PROMETHEUS_PORT=9090      # loopback only: reach it with an SSH tunnel
# MONITORING_ALERTMANAGER_PORT=9093    # loopback only
# PROMETHEUS_RETENTION=15d             # how long Prometheus keeps its series
