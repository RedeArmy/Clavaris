<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.clavaris</groupId>
        <artifactId>clavaris-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>client-registry-module</artifactId>
    <packaging>jar</packaging>
    <name>client-registry-module</name>
    <description>
        Registered consuming applications (OAuth clients), authorization codes, and the
        platform-tier PlatformClient that authenticates the management API itself
        (ADR-0010, Organization provisioning). First real code: PlatformClient bootstrap
        (BR-PLATFORM-03).
    </description>

    <dependencies>
        <!-- TD-SEC-007/TD-SEC-018: AuditEventRecorder — RotatePlatformClientSecretService/
             DeactivatePlatformClientService both write an audit_events row. Same threshold/
             rationale as organization-module's and identity-module's own identical dependency. -->
        <dependency>
            <groupId>com.clavaris</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- TD-SEC-018: RotatePlatformClientSecretController/DeactivatePlatformClientController
             read the request's own Authentication to resolve who is calling (AuditActor) — same
             rationale as organization-module's/identity-module's own identical dependency. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <!-- CreateOrganizationController's counterpart here: RegisterOAuthClientController
             (infrastructure/adapter/in/web), POST /api/v1/admin/organizations/{organizationId}/clients. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- @NotEmpty/@NotBlank on RegisterOAuthClientRequest — starter-web alone doesn't pull in
             a Bean Validation implementation (Hibernate Validator) since Spring Boot 3. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- @Operation/@ApiResponse annotations only (ADR-0008) — same convention as
             organization-module's own pom.xml; the full springdoc starter that serves
             /v3/api-docs + Swagger UI is wired once, in app/pom.xml. -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.52</version>
        </dependency>
        <!-- JSON serialization for platform_clients.allowed_scopes / oauth_clients' three JSON-array
             columns (data-model.md §2) — spring-boot-starter-web now pulls Jackson in transitively
             too, but this stays explicit rather than relying on that indirection. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <!-- ADR-0005-style hashing for client_secret_hash — same "hash-not-plaintext" principle
             as PasswordCredential (data-model.md §2). Not a dependency on identity-module's own
             Argon2PasswordHasher: business modules stay mutually independent (app is the only
             module allowed to see the whole tree, the hexagonal dependency rule's spirit applied
             at the module-graph level) — a small amount of duplication between two modules is an
             acceptable, explicit trade-off; refactor into a shared utility only once a third
             module needs the same thing (YAGNI, not premature abstraction). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.85.2</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- test-strategy.md §2: persistence adapters get a real-Postgres integration test, not
             just a mocked-port unit test — JpaPlatformClientRepositoryTest runs the actual
             V20260818170000 migration (not a Hibernate-generated schema) via @DataJpaTest +
             Testcontainers, scoped to this module alone so PR2 carries its own coverage instead
             of relying on app's later end-to-end PlatformTokenIssuanceIntegrationTest for it. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
