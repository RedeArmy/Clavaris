# TD-FUT-011 / ADR-0015: production Alertmanager config template — real Resend SMTP relay
# (resend.com/docs/send-with-smtp), not Mailpit. Names/structure only, no real credential — same
# "names-only committed template, real file gitignored" convention as .env.example.
#
# To use: copy this file to infra/observability/alertmanager.prod.yml (gitignored — see .gitignore),
# fill in a real recipient and a real Resend API key, then bind-mount it over alertmanager.yml's own
# path instead of editing that file in place:
#   docker compose -f docker-compose.yml -f docker-compose.observability.yml \
#     -f docker-compose.observability.prod.yml up -d
# (a matching docker-compose.observability.prod.yml that overrides the alertmanager service's own
# volume mount to point at this file is the natural pairing — not included here, since its shape
# depends on the eventual real deployment topology, TD-FUT-013.)

global:
  smtp_smarthost: "smtp.resend.com:587"
  smtp_from: "clavaris-alerts@REPLACE_WITH_YOUR_VERIFIED_RESEND_DOMAIN"
  smtp_auth_username: "resend"
  # Resend's own documented convention: the literal word "resend" as username, the full API key
  # (including its re_ prefix) as the password — never commit a real value here.
  smtp_auth_password: "REPLACE_WITH_A_REAL_RESEND_API_KEY"
  smtp_require_tls: true

route:
  group_by: ["alertname"]
  group_wait: 10s
  group_interval: 2m
  repeat_interval: 4h
  receiver: email-alerts
  routes:
    - matchers:
        - severity="critical"
      receiver: email-alerts
      group_wait: 0s
      repeat_interval: 30m

receivers:
  - name: email-alerts
    email_configs:
      - to: "REPLACE_WITH_A_REAL_ON_CALL_ADDRESS"
        send_resolved: true
