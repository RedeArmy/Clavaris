# TD-FUT-011 / ADR-0015: production Alertmanager config template — real Resend SMTP relay
# (resend.com/docs/send-with-smtp), not Mailpit. Names/structure only, no real credential — same
# "names-only committed template, real file gitignored" convention as .env.example.
#
# To use (TD-PROC-032): on the deployment host, copy this file to monitoring/alertmanager.yml next
# to docker-compose.prod.yml, replace every REPLACE_WITH_... value, and run deploy.sh. That file's
# existence is what switches the monitoring stack on (docker-compose.monitoring.yml); deploy.sh
# refuses to continue while a REPLACE_WITH_ placeholder is left in it. It holds a credential, so it
# is never committed and never synced: sync-deploy-files.sh does not touch it.
#
# The heartbeat receiver at the bottom is what covers the host itself dying: Prometheus's always
# firing Watchdog alert is sent to an external service (healthchecks.io, Better Stack, Cronitor, an
# uptime monitor with a push URL) that notifies you when the pings stop. Put the push URL in
# monitoring/heartbeat-url on the host (one line, no quotes) and keep the receiver. If you have no
# such service, delete the Watchdog route and the receiver, and record that in the risk register.
global:
  smtp_smarthost: "smtp.resend.com:587"
  smtp_from: "clavaris-alerts@REPLACE_WITH_YOUR_VERIFIED_RESEND_DOMAIN"
  smtp_auth_username: "resend"
  # Resend's own documented convention: the literal word "resend" as username, the full API key
  # (including its re_ prefix) as the password — never commit a real value here.
  smtp_auth_password: "REPLACE_WITH_A_REAL_RESEND_API_KEY"
  smtp_require_tls: true

route:
  group_by: ["alertname"]
  group_wait: 10s
  group_interval: 2m
  repeat_interval: 4h
  receiver: email-alerts
  routes:
    - matchers:
        - alertname="Watchdog"
      receiver: heartbeat
      group_wait: 0s
      group_interval: 5m
      repeat_interval: 5m
    - matchers:
        - severity="critical"
      receiver: email-alerts
      group_wait: 0s
      repeat_interval: 30m

receivers:
  - name: email-alerts
    email_configs:
      - to: "REPLACE_WITH_A_REAL_ON_CALL_ADDRESS"
        send_resolved: true
  - name: heartbeat
    webhook_configs:
      - url_file: /etc/alertmanager/heartbeat-url
        send_resolved: false
