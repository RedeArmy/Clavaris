<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.clavaris</groupId>
        <artifactId>clavaris-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>organization-module</artifactId>
    <packaging>jar</packaging>
    <name>organization-module</name>
    <description>
        Organization (tenant isolation boundary, ADR-0010) and Workspace. First real code:
        CreateOrganization (BR-ORG-06) — an operator-only action that provisions the initial
        SigningKey synchronously, in the same operation, via a port implemented in app (the one
        module allowed to depend on both organization-module and identity-module).
    </description>

    <dependencies>
        <!-- TD-SEC-007: AuditEventRecorder — CreateOrganizationService/SetRateLimitPolicyFor
             OrganizationService both write an audit_events row in the same transaction as their
             own domain write. The one cross-cutting concern this codebase's own YAGNI threshold
             (client-registry-module's pom.xml: "refactor into a shared utility only once a third
             module needs the same thing") is now met by — identity-module (TD-SEC-008) and
             client-registry-module (TD-SEC-018) need the exact same port. -->
        <dependency>
            <groupId>com.clavaris</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- TD-SEC-007: CreateOrganizationController/SetRateLimitPolicyController both read the
             request's own Authentication to resolve who is calling (AuditActor) — spring-security-
             core alone for the Authentication type itself, not the full config/web starter this
             module has no filter chain of its own to build. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <!-- CreateOrganizationController (infrastructure/adapter/in/web) — the REST controller;
             PlatformOrganizationDashboardController (ADR-0012) is the Thymeleaf one, below. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- ADR-0012: PlatformOrganizationDashboardController's own hosted UI — same "server-side
             rendered, not a SPA" convention as identity-module's own login/register pages. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!-- @NotBlank on CreateOrganizationRequest.name/CreateOrganizationForm.name — starter-web
             alone doesn't pull in a Bean Validation implementation (Hibernate Validator) since
             Spring Boot 3. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- @Operation/@ApiResponse annotations only (ADR-0008) — the full springdoc starter that
             actually serves /v3/api-docs + Swagger UI is a runtime concern of the final assembled
             deployable, wired in app/pom.xml, not needed just to write the annotations here. -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.54</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- test-strategy.md §2: persistence adapters get a real-Postgres integration test —
             JpaOrganizationRepositoryTest runs the actual organizations migration (not a
             Hibernate-generated schema), scoped to this module alone. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
