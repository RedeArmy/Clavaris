<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.clavaris</groupId>
        <artifactId>clavaris-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>organization-module</artifactId>
    <packaging>jar</packaging>
    <name>organization-module</name>
    <description>
        Organization (tenant isolation boundary, ADR-0010) and Workspace. First real code:
        CreateOrganization (BR-ORG-06) — an operator-only action that provisions the initial
        SigningKey synchronously, in the same operation, via a port implemented in app (the one
        module allowed to depend on both organization-module and identity-module).
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- CreateOrganizationController (infrastructure/adapter/in/web) — the only REST controller
             in this module so far. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- @NotBlank on CreateOrganizationRequest.name — starter-web alone doesn't pull in a
             Bean Validation implementation (Hibernate Validator) since Spring Boot 3. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- @Operation/@ApiResponse annotations only (ADR-0008) — the full springdoc starter that
             actually serves /v3/api-docs + Swagger UI is a runtime concern of the final assembled
             deployable, wired in app/pom.xml, not needed just to write the annotations here. -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.52</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
