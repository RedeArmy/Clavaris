<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.clavaris</groupId>
    <artifactId>clavaris-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>clavaris-parent</name>
    <description>Parent POM for Clavaris, a standalone OIDC/OAuth2 identity provider.</description>

    <properties>
        <!-- CLAUDE.md §3 locked stack: Java 21, Spring Boot 3.4. -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Bump to the latest 3.4.x patch at implementation time — pinned
             here only so the module tree resolves, not a deliberate patch choice. -->
        <spring-boot.version>4.1.0</spring-boot.version>
        <!-- Overrides the Spring Boot BOM's own managed Testcontainers version:
             an old 1.20.4 default hardcoded Docker API 1.32 in its
             detection-phase ping, which recent Docker Engine builds (this dev
             host: 29.5.2, min supported API 1.40) reject outright — confirmed
             live, not assumed. Now on the 2.0.x line, which renamed several
             artifacts (testcontainers-junit-jupiter, testcontainers-postgresql
             — see app/pom.xml) relative to 1.x. -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <!-- Coverage data SonarCloud's Quality Gate is computed against
             (git-workflow.md §4) — a Quality Gate with no coverage report to
             read is not actually measuring anything. -->
        <!-- 0.8.12's bundled/shaded ASM can't instrument JDK 25 runtime
             classes ("Unsupported class file major version 69" while
             instrumenting java.sql.SQLException, non-fatal but silently
             degrades coverage) — confirmed live. 0.8.15 targets newer JDKs. -->
        <jacoco.version>0.8.15</jacoco.version>
        <!-- coding-standards.md §1: formatting and clean-code rules enforced
             as a real build gate (mvn verify fails on a violation), not a
             style-guide document nobody re-reads before every PR. -->
        <!-- 2.44.3's bundled google-java-format/javac-internals shim does not
             support JDK 25's internal compiler API shape
             (NoSuchMethodError: Log$DeferredDiagnosticHandler.getDiagnostics)
             — confirmed live against app/Dockerfile's build stage
             (eclipse-temurin:25-jdk). 3.10.0 fixes this. -->
        <spotless.version>3.10.0</spotless.version>
        <!-- 3.26.0's bundled ASM can't parse JDK 25 class files
             ("Unsupported class file major version 69"), silently degrading
             type-resolution-dependent rules (e.g. LooseCouplingRule) instead
             of hard-failing — confirmed live under JDK 25. Bumped for the
             same reason as spotless.version above. -->
        <pmd-plugin.version>3.28.0</pmd-plugin.version>
    </properties>

    <!--
        Spring Boot's BOM is imported, not used as the Maven <parent>, so that
        com.clavaris:clavaris-parent (this file) stays the actual parent for
        every module — keeps dependencyManagement centralized here instead of
        split across two parent chains.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Declared BEFORE spring-boot-dependencies, and wins, because
                 spring-boot-dependencies imports testcontainers-bom itself —
                 overriding ${testcontainers.version} alone does not reach a
                 BOM nested inside another imported BOM (a known Maven
                 limitation, confirmed by testing: the property override was
                 silently ignored until this explicit direct import was
                 added). First matching groupId:artifactId in
                 dependencyManagement wins; this entry, being first, does. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- Bound here, not in pluginManagement — every child module inherits
             these executions automatically (Maven's default plugin
             inheritance), no per-module opt-in needed. Applies to code that
             doesn't exist yet as much as to what does (CLAUDE.md §11): the
             gate exists before the first real domain class does. -->
        <plugins>
            <!-- Formatting (coding-standards.md §1): Google Java Format, the
                 same zero-config style Google's own engineers write against —
                 no house style to invent or bikeshed, and no ambiguity for
                 whoever writes the next class about which formatter settings
                 "the project uses." `mvn spotless:apply` fixes violations
                 locally; `mvn verify` (spotless:check, bound to validate —
                 fails before compilation even starts) refuses to build
                 unformatted code. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat/>
                        <removeUnusedImports/>
                        <importOrder/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Clean-code rules (coding-standards.md §1) — distinct concern
                 from formatting above: unused/dead code, empty catch blocks,
                 needlessly complex methods, naming conventions, non-idiomatic
                 constructs. Bound to verify (needs compiled classes), fails
                 the build on any violation at the default priority
                 threshold — deliberately strict while the codebase is still
                 small enough that fixing a flagged violation is cheap; revisit
                 the threshold only if a specific rule proves to be genuine
                 noise against this codebase, not preemptively. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${pmd-plugin.version}</version>
                <configuration>
                    <linkXRef>false</linkXRef>
                    <printFailingErrors>true</printFailingErrors>
                    <rulesets>
                        <ruleset>${maven.multiModuleProjectDirectory}/pmd-ruleset.xml</ruleset>
                    </rulesets>
                </configuration>
                <!-- 3.28.0 pins pmd-core 7.17.0 internally (not the latest
                     pmd-core release), which bundles ASM 9.7.1 — predates JDK
                     25 class-file support ("Unsupported class file major
                     version 69"). Forcing pmd-core itself, not just asm,
                     because overriding asm alone left the error unchanged
                     (confirmed live) — pmd-core 7.17.0's own dependency
                     mediation was still winning. -->
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>7.26.0</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>7.26.0</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.10.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>pmd-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>common</module>
        <module>identity-module</module>
        <module>organization-module</module>
        <module>client-registry-module</module>
        <module>app</module>
    </modules>

</project>
