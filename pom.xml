<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.clavaris</groupId>
    <artifactId>clavaris-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>clavaris-parent</name>
    <description>Parent POM for Clavaris, a standalone OIDC/OAuth2 identity provider.</description>

    <properties>
        <!-- CLAUDE.md §3 locked stack: Java 21, Spring Boot 3.4. -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Bump to the latest 3.4.x patch at implementation time — pinned
             here only so the module tree resolves, not a deliberate patch choice. -->
        <spring-boot.version>4.1.0</spring-boot.version>
        <!-- Overrides Spring Boot 3.4.1's BOM-managed 1.20.4: that version's
             docker-java client hardcodes API 1.32 in its detection-phase ping,
             which recent Docker Engine builds (this dev host: 29.5.2, min
             supported API 1.40) reject outright — confirmed live, not assumed.
             1.21.x fixes this while staying pre-2.0 (Spring Boot 3.4's
             spring-boot-testcontainers integration is only verified against
             the Testcontainers 1.x line). -->
        <testcontainers.version>2.0.5</testcontainers.version>
    </properties>

    <!--
        Spring Boot's BOM is imported, not used as the Maven <parent>, so that
        com.clavaris:clavaris-parent (this file) stays the actual parent for
        every module — keeps dependencyManagement centralized here instead of
        split across two parent chains.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Declared BEFORE spring-boot-dependencies, and wins, because
                 spring-boot-dependencies imports testcontainers-bom itself —
                 overriding ${testcontainers.version} alone does not reach a
                 BOM nested inside another imported BOM (a known Maven
                 limitation, confirmed by testing: the property override was
                 silently ignored until this explicit direct import was
                 added). First matching groupId:artifactId in
                 dependencyManagement wins; this entry, being first, does. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <modules>
        <module>common</module>
        <module>identity-module</module>
        <module>organization-module</module>
        <module>client-registry-module</module>
        <module>app</module>
    </modules>

</project>
