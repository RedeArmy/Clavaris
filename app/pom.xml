<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.clavaris</groupId>
        <artifactId>clavaris-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>app</artifactId>
    <packaging>jar</packaging>
    <name>app</name>
    <description>
        Spring Boot bootstrap module — the single deployable (system-design-document.md §3,
        modular monolith). Owns the @SpringBootApplication entry point and cross-cutting
        infrastructure wiring (Actuator health checks) only. No domain/application code lives
        here — it depends on the business modules, never the reverse, same direction as the
        hexagonal dependency rule applied at the module-graph level.
    </description>

    <dependencies>
        <!-- Business modules — placeholder deps until each has real classes to expose. -->
        <dependency>
            <groupId>com.clavaris</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clavaris</groupId>
            <artifactId>identity-module</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clavaris</groupId>
            <artifactId>organization-module</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clavaris</groupId>
            <artifactId>client-registry-module</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clavaris</groupId>
            <artifactId>webhook-module</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Actuator: health checks from day one (DB + Redis + liveness/readiness probes),
             per the gap flagged in nfr-quality-attributes.md §7. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- TD-FUT-011 / ADR-0015: exposes /actuator/prometheus (real HTTP-per-endpoint latency
             percentiles come free from Actuator's own WebMvcMetricsFilter once this is on the
             classpath, JVM/HikariCP/Tomcat metrics likewise) for the self-hosted Prometheus in
             docker-compose.observability.yml to scrape. Version managed by the Spring Boot BOM
             (spring-boot-dependencies transitively imports the Micrometer BOM). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- TD-FUT-011 / ADR-0015: full per-request traceability — every HTTP request gets a
             trace/span id, propagated automatically into every structured (ECS) log line emitted
             during that request — confirmed live against a real running instance's own JSON log
             output, not assumed from the mechanism's name: Brave's MDCScopeDecorator (brave-
             context-slf4j, pulled in transitively by spring-boot-starter-zipkin) populates the
             logging MDC with flat `traceId`/`spanId` keys, which Spring Boot's ECS structured-log
             formatter (ElasticCommonSchemaStructuredLogFormatter) dumps as flat top-level JSON
             fields — not nested under ECS's own `trace.id`/`transaction.id` convention, since that
             nesting is this formatter's own choice to make per MDC key, not automatic — and
             exported to Zipkin for visual
             per-layer timing. Brave chosen over the OTel bridge — smaller dependency footprint,
             and Zipkin's wire format is Brave's native one, no extra translation layer needed for
             a single-process monolith with no cross-service propagation to worry about yet.

             The real starter, not the bare micrometer-tracing-bridge-brave/zipkin-reporter-brave
             jars — confirmed live (a real running instance's own Zipkin showed zero traces despite
             those two compiling and starting cleanly) that Spring Boot 4.1 moved its tracing
             autoconfiguration into its own dedicated modules (spring-boot-micrometer-tracing-brave,
             spring-boot-zipkin), which this starter pulls in and the bare Micrometer jars alone do
             not — unlike Boot 3.x, where spring-boot-actuator-autoconfigure carried this glue
             itself. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-zipkin</artifactId>
        </dependency>

        <!-- ADR-0003, ADR-0010 (Organization provisioning): issues the platform issuer's own
             client_credentials tokens (BR-PLATFORM-01) — wired here, not in identity-module or
             client-registry-module, because it needs both at once (client-registry-module's
             PlatformClient for the RegisteredClientRepository, identity-module's
             PlatformSigningKeyMaterial for the JWKSource/signer), and app is the one module
             already allowed to depend on every business module (the module-graph's own
             dependency rule). Uses the two implementation patterns the spike validated
             (docs/03-architecture/spikes/0001-spring-authorization-server-multitenancy.md
             Appendix A/B) as the starting point, per the "don't build ahead of the use case
             that needs it" principle and the spike's own §7 recommendation, not re-derived
             from scratch. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-authorization-server</artifactId>
        </dependency>
        <!-- Validates incoming Bearer tokens on /api/v1/admin/** against the platform issuer's own
             JWKS (BR-PLATFORM-02) — a different concern from issuing them above, hence a separate
             starter/SecurityFilterChain, not the same one. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- ADR-0020 (social login): Clavaris itself as an OAuth2/OIDC CLIENT of Google/GitHub —
             the opposite role from the two starters above (which make Clavaris a server/resource
             server). Provides the oauth2Login() DSL, ClientRegistrationRepository autoconfiguration
             (driven by spring.security.oauth2.client.registration.* in application.yml), and the
             default OidcUserService/DefaultOAuth2UserService SocialLoginConfig builds on. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <!-- ADR-0008: springdoc generates /v3/api-docs + Swagger UI from the @Operation/
             @ApiResponse annotations already on organization-module's CreateOrganizationController
             — the runtime doc-serving endpoint only needs to exist on app's own classpath (the
             final assembled deployable) to pick up every annotated controller from every
             dependency module; organization-module itself only needs the lightweight annotations
             artifact (see its own pom.xml) to write those annotations, not this whole starter. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <!-- 2.x doesn't support Spring Framework 7/Boot 4 — confirmed: 3.0.0 is the first
                 version with that support, 3.0.1 specifically fixed a 7.0.2 compat regression;
                 3.1.0 is the latest available on Maven Central as of this writing. -->
            <version>3.1.0</version>
        </dependency>

        <!-- DB health indicator (DataSourceHealthIndicator) is auto-configured once
             spring-boot-starter-data-jpa + a driver are on the classpath (ADR-0004: Postgres). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Schema is Flyway-owned, not Hibernate-owned (data-model.md §4) — every
             environment reaches the same schema by running the same versioned
             migrations automatically at startup, never by someone running a .sql
             file by hand.
             spring-boot-starter-flyway, not a raw flyway-core dependency: Spring
             Boot 4 split FlywayAutoConfiguration out of spring-boot-autoconfigure
             into its own spring-boot-flyway module, only pulled in by this
             starter — confirmed live (spring-boot-autoconfigure-4.1.0.jar
             contains zero Flyway classes; the DEBUG conditions-evaluation report
             doesn't mention Flyway at all). Depending on flyway-core directly, as
             before, put the library on the classpath without ever registering the
             Flyway bean or running a migration at startup — a real, previously
             undetected gap: Hibernate's ddl-auto=validate never caught it because
             this codebase has zero @Entity classes yet, so there was nothing to
             validate a schema against. flyway-database-postgresql is the
             PostgreSQL-specific module Flyway 10+ split out of flyway-core;
             still declared explicitly since the starter doesn't pull in a
             database-specific module for you. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Redis health indicator is auto-configured once this starter is present
             and a RedisConnectionFactory bean exists (ADR-0004: Redis for rate limiting/session cache). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- TD-ARCH-002 (closed): backs HttpSession with real, restart-surviving, cross-instance
             Redis storage instead of servlet-container heap. Spring Boot autoconfigures the whole
             SessionRepositoryFilter wiring once this is on the classpath and store-type: redis is
             set (application.yml) — no manual @EnableRedisIndexedHttpSession needed. The "indexed"
             repository-type (also set there) is what makes SpringSessionBackedSessionRegistry's
             principal-name lookup below possible; the plain (non-indexed) repository this starter
             would otherwise default to does not support it. -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>

        <!-- TD-PERF-006: bounded/self-evicting in-process caches for CachingClientDomainConfigRepository/
             CachingRateLimitPolicyRepository, replacing their own hand-rolled unbounded
             ConcurrentHashMap-plus-manual-TTL shape — no version pinned, Spring Boot's own BOM
             (imported in the root pom) already manages this at 3.2.4, so this stays whatever
             version Spring Boot itself has already vetted, the same "ride the platform's own
             tested pairing" posture every other unversioned dependency in this file already
             follows. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Enforces the hexagonal dependency rule as a real,
             CI-checked constraint, not a code-review convention. Lives here
             (not per-module) because "app" is the one module that already
             depends on every business module, so it's the single place that
             can see the whole com.clavaris tree at once — see
             coding-standards.md §2, test-strategy.md §2. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.5.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Proves the Flyway migrations (data-model.md §4) apply cleanly against a
             real Postgres, in CI, on every build — not just verified once by hand.
             Versions managed by the Spring Boot BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.0 renamed these artifacts (testcontainers-junit-jupiter,
             testcontainers-postgresql — the old junit-jupiter/postgresql coordinates
             from the 1.x line no longer resolve against testcontainers-bom 2.0.5). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>clavaris-app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.clavaris.app.ClavarisApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Cross-module coverage attribution gap, confirmed live on SonarCloud:
                 RegisterAccountIntegrationTest lives here (app), not in identity-module,
                 because it needs the full Spring context + aggregated Flyway migrations
                 only app has (same reasoning as FlywayMigrationIntegrationTest,
                 MigrationDataPreservationTest). It genuinely exercises identity-module's
                 persistence adapters (JpaAccountRepository, the JPA entities,
                 UseCaseConfig) end to end against a real Postgres — but the regular,
                 per-module jacoco:report goal (root pom.xml) only ever correlates a
                 module's own target/jacoco.exec against that same module's own
                 target/classes, so hits recorded here for identity-module's classes
                 never reach identity-module's own jacoco.xml. SonarCloud reported those
                 classes at a flat 0.0% as a result, despite being covered by a real
                 integration test. report-aggregate fixes this the standard way for a
                 multi-module Maven reactor: run only here, where every business module
                 (common, identity-module, organization-module, client-registry-module,
                 webhook-module)
                 is already a declared dependency, it combines every reactor module's
                 exec data against every dependency's own compiled classes into one
                 report — ci.yml's sonarcloud job points
                 sonar.coverage.jacoco.xmlReportPaths at this file specifically, alongside
                 each module's own report, so Sonar merges both views per source file. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
